{
  "name": "visionsync",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "server",
    "extension"
  ],
  "scripts": {
    "dev": "npm run extension:build && npm run dev --workspace @visionsync/web",
    "build": "npm run build --workspace @visionsync/extension && npm run build --workspace @visionsync/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @visionsync/web",
    "db:push": "npm run db:push --workspace @visionsync/web",
    "db:indexes": "npm run db:indexes --workspace @visionsync/web",
    "extension:build": "npm run build --workspace @visionsync/extension"
  },
  "engines": {
    "node": ">=22.14"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.2", "effect": "3.20.1" },
    "@typescript-eslint/typescript-estree": { "minimatch": "11.0.5" }
  }
}
