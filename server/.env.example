# MongoDB replica set required, including development (Atlas or local rs0).
DATABASE_URL="mongodb://127.0.0.1:27017/visionsync?replicaSet=rs0"
NEXTAUTH_URL="http://localhost:3001"
AUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET=""
AUTH_SECRET=""
# Explicit opt-in required before sending real Meta events.
META_SEND_ENABLED="false"
META_GRAPH_VERSION="v27.0"
# Private persistent filesystem, relative to server/ or an absolute path on the host.
UPLOADS_DIR="../storage/uploads"

# Account activation and password recovery: authenticated SMTP and public AUTH_URL in production.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Extra LAN hostnames/IPs for Next.js dev assets (comma separated, without ports).
DEV_ALLOWED_ORIGINS="192.168.0.2"

# Audio recording conversion: FFmpeg with libopus on the server (or absolute executable path).
FFMPEG_PATH="ffmpeg"
